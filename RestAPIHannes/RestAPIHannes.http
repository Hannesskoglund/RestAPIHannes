@RestAPIHannes_HostAddress = http://localhost:5106

GET {{RestAPIHannes_HostAddress}}/weatherforecast/
Accept: application/json

###Get All
GET {{RestAPIHannes_HostAddress}}/Ads


###Get Single
GET {{RestAPIHannes_HostAddress}}/Ads/3

###Create new
POST {{RestAPIHannes_HostAddress}}/Ads
Content-Type: application/json
{
    "title": "iPhone 15 Pro",
  "description": "iPhone 15 Pro i mycket bra skick, 256GB.",
  "price": 9500.00,
  "category": "Elektronik",
  "createdAt": "2026-11-26T10:00:00",
  "isActive": true,
  "sellerName": "Hannes Andersson",
  "sellerEmail": "hannes@example.com"
}

###Update
PUT {{RestAPIHannes_HostAddress}}/Ads/2
Content-Type: application/json
{
  "title": "Samsung Galaxy S25",
  "description": "Samsung Galaxy S25, 512GB. Nästan oanvänd.",
  "price": 10500.00,
  "category": "Elektronik",
  "createdAt": "2026-11-26T10:00:00",
  "isActive": true,
  "sellerName": "Erik Svensson",
  "sellerEmail": "erik@example.com"
}

###Delete
DELETE {{RestAPIHannes_HostAddress}}/Ads/4

###Patch 

PATCH {{RestAPIHannes_HostAddress}}/Ads/3 HTTP/1.1
Content-Type: application/json

[
  {
    "op": "replace",
    "path": "/price",
    "value": 500.00
  }


]
